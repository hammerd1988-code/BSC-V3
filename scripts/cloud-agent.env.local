# Local development env for Blood Sweat Code (BSC-V3), wired to the local
# Supabase stack started by `supabase start`. Copied to .env.local by
# scripts/cloud-agent-install.sh. The anon/service keys below are the well-known
# Supabase CLI demo keys — identical on every local install, not real secrets.

# ---- Supabase (local stack) ----
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
VITE_SUPABASE_STORAGE_BUCKET="media"

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Google OAuth placeholders — required by supabase/config.toml interpolation.
GOOGLE_OAUTH_CLIENT_ID="placeholder"
GOOGLE_OAUTH_CLIENT_SECRET="placeholder"

# ---- AI (optional; unset in local dev) ----
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
VITE_OPENROUTER_ADMIN_KEY=""

# ---- App / connectivity (dev:full serves frontend + API + Socket.io on :3001) ----
APP_URL="http://localhost:3001"
CLIENT_ORIGIN="http://localhost:3001"

# ---- Webhook auth (development shared secret) ----
AGENT_WEBHOOK_SECRET="local-dev-webhook-secret"
