{
  "expo": {
    "name": "Casper Roaming Ghost SSH",
    "slug": "casper-roaming-ghost-ssh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.bloodsweatcode.casperssh"
    },
    "android": {
      "package": "org.bloodsweatcode.casperssh",
      "permissions": [
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
